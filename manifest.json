{
  "manifest_version": 3,
  "name": "AI 双语翻译",
  "short_name": "AI 双语翻译",
  "version": "2.1.1",
  "description": "在英文网页与 YouTube / Bilibili 视频上叠加中文译文，支持 Google / DeepL / OpenAI 兼容 / 阿里云百炼等翻译引擎，并提供划词词典与双语字幕。",
  "minimum_chrome_version": "116",
  "author": "AI Bilingual Translator contributors",

  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "activeTab",
    "sidePanel"
  ],

  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.openai.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "AI 双语翻译",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },

  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/content/core.js",
        "src/content/page-translator.js",
        "src/content/selection.js",
        "src/content/subtitles.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译 / 还原当前网页"
    },
    "toggle-mode": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "切换显示模式（双语 / 仅中文 / 悬停）"
    },
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "查询选中的单词或句子"
    }
  }
}